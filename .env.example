# Postgres (usado pelo docker-compose para subir o container do banco)
POSTGRES_USER=advice
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=advice

# String de conexão completa usada pela aplicação. O HOST muda conforme
# o ambiente — prestar atenção nisso:
#
#   dev nativo (pnpm dev:web/dev:worker)  -> localhost:5432
#   docker compose local                  -> postgres:5432
#   Swarm no VPS (docker-stack.yml)       -> advice_postgres:5432
#
# No Swarm é OBRIGATÓRIO o nome qualificado `advice_postgres` (com o
# prefixo da stack). O `web` fica na rede Monadanet pra ser alcançado
# pelo Traefik, e nessa rede JÁ EXISTE outro serviço com alias
# `postgres` (o postgres_postgres compartilhado do VPS) — usar o nome
# curto faz a app conectar no banco do projeto errado.
DATABASE_URL=postgresql://advice:change-me-strong-password@advice_postgres:5432/advice

# Evolution API — instância "advice", já rodando no mesmo VPS.
# EVOLUTION_API_KEY é a API key GLOBAL da Evolution API (não uma apikey
# por instância — a instância "Sophia" original usava uma apikey própria
# que nunca conseguiu enviar mensagem; a API key global funcionou).
EVOLUTION_API_BASE_URL=https://evolution.autozapx.com
EVOLUTION_API_KEY=your-evolution-global-api-key-here
EVOLUTION_INSTANCE_NAME=advice

# Número (E.164, sem "+") que recebe os lembretes
WHATSAPP_DESTINO=5522999491428
